    "nom": "L'Appel de Joseph le Juste",
    "type": "Mystères de Saint Joseph",
    "numero": 1,
    "fruit": "La foi et l'obéissance silencieuse",
    "clausule_et_jesus": "confié à Joseph le Juste",

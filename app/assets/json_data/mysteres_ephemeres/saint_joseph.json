    "fruit": "La protection et le dévouement familial",
    "clausule_et_jesus": "protégé en Égypte",
    "auteur": "Matthieu",
    "chapitre": 2,
    "premier_verset": 13,
    "verset_fin": 14,
    "traduction": "Crampon 1923",
    "texte": "Un ange du Seigneur apparut en songe à Joseph, et dit : « Lève-toi, prends le petit enfant et sa mère, et fuis en Égypte »... Joseph s'étant levé, prit de nuit le petit enfant et sa mère, et se retira en Égypte."
  },
  {
    "id": "joseph_3",
    "nom": "L'Atelier et le Silence de Nazareth",
    "type": "Mystères de Saint Joseph",
    "numero": 3,
    "fruit": "La dignité du travail humble",
    "clausule_et_jesus": "humble artisan de Nazareth",
    "auteur": "Matthieu",
    "chapitre": 13,
    "premier_verset": 55,
    "verset_fin": 55,
    "traduction": "Crampon 1923",
    "texte": "N'est-ce pas le fils du charpentier ? Sa mère ne s'appelle-t-elle pas Marie, et ses frères Jacques, Joseph, Simon et Jude ?"

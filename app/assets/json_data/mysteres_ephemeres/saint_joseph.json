  {
    "id": "joseph_2",
    "nom": "La Fuite et l'Exil en Égypte",
    "type": "Mystères de Saint Joseph",
    "numero": 2,
    "fruit": "La protection et le dévouement familial",
    "clausule_et_jesus": "protégé en Égypte",
    "auteur": "Matthieu",
    "chapitre": 2,
    "premier_verset": 13,
    "verset_fin": 14,
    "traduction": "Crampon 1923",
    "texte": "Un ange du Seigneur apparut en songe à Joseph, et dit : « Lève-toi, prends le petit enfant et sa mère, et fuis en Égypte »... Joseph s'étant levé, prit de nuit le petit enfant et sa mère, et se retira en Égypte."
  },
  {
    "id": "joseph_3",
    "nom": "L'Atelier et le Silence de Nazareth",
    "type": "Mystères de Saint Joseph",
    "numero": 3,
    "fruit": "La dignité du travail humble",
    "clausule_et_jesus": "humble artisan de Nazareth",
    "auteur": "Matthieu",
    "chapitre": 13,
    "premier_verset": 55,
    "verset_fin": 55,
    "traduction": "Crampon 1923",
    "texte": "N'est-ce pas le fils du charpentier ? Sa mère ne s'appelle-t-elle pas Marie, et ses frères Jacques, Joseph, Simon et Jude ?"
  },
  {
    "id": "joseph_4",
    "nom": "La Recherche à Jérusalem",
    "type": "Mystères de Saint Joseph",
    "numero": 4,
    "fruit": "La persévérance dans la recherche de Dieu",
    "clausule_et_jesus": "cherché dans la douleur",
    "auteur": "Luc",
    "chapitre": 2,
    "premier_verset": 48,
    "verset_fin": 49,
    "traduction": "Crampon 1923",
    "texte": "Sa mère lui dit : « Mon enfant, pourquoi as-tu agi ainsi avec nous ? Vois, ton père et moi, nous te cherchions avec angoisse. » Il leur dit : « Pourquoi me cherchiez-vous ? Ne saviez-vous pas qu'il faut que je sois aux affaires de mon Père ? »"
  },
  {
    "id": "joseph_5",
    "nom": "L'Espérance des Mourants",
    "type": "Mystères de Saint Joseph",
    "numero": 5,
    "fruit": "La grâce d'une sainte agonie et d'une heureuse mort",
    "clausule_et_jesus": "espérance des mourants",
    "auteur": "Luc",
    "chapitre": 2,
    "premier_verset": 29,
    "verset_fin": 30,
    "traduction": "Crampon 1923",
    "texte": "Maintenant, Seigneur, tu laisses ton serviteur s'en aller en paix, selon ta parole ; car mes yeux ont vu ton salut."

    "nom": "Une lampe pour mes pas",
    "type": "Église de Veurey-Voroize",
    "numero": 1,
    "fruit": "La docilité à la Parole",
    "clausule_et_jesus": "Parole de lumière",
    "auteur": "Psaumes",
    "chapitre": 119,
    "premier_verset": 105,
    "verset_fin": 105,
    "traduction": "Crampon 1923",
    "texte": "Ta parole est une lampe à mes pieds, et une lumière sur mon sentier."
  },
  {
    "id": "veurey_2",
    "nom": "Le Pain de vie",
    "type": "Église de Veurey-Voroize",
    "numero": 2,
    "fruit": "La foi en Jésus",
    "clausule_et_jesus": "pain de vie",
    "auteur": "Jean",
    "chapitre": 6,
    "premier_verset": 47,
    "verset_fin": 48,
    "traduction": "Crampon 1923",
    "texte": "En vérité, en vérité, je vous le dis, celui qui croit en moi a la vie éternelle. Je suis le pain de vie."
  },
  {
    "id": "veurey_3",
    "nom": "Les Béatitudes",
    "type": "Église de Veurey-Voroize",
    "numero": 3,
    "fruit": "La pauvreté du cœur",
    "clausule_et_jesus": "notre bonheur",
    "auteur": "Matthieu",
    "chapitre": 5,
    "premier_verset": 3,
    "verset_fin": 4,
    "traduction": "Crampon 1923",
    "texte": "Heureux les pauvres d'esprit, car le royaume des cieux est à eux ! Heureux ceux qui pleurent, car ils seront consolés !"
  },
  {
    "id": "veurey_4",
    "nom": "L'appel d'Abraham",
    "type": "Église de Veurey-Voroize",
    "numero": 4,
    "fruit": "La confiance pour partir",
    "clausule_et_jesus": "qui nous appelle",
    "auteur": "Genèse",
    "chapitre": 12,
    "premier_verset": 1,
    "verset_fin": 2,
    "traduction": "Crampon 1923",
    "texte": "Yahweh dit à Abram : Va-t'en de ton pays, de ta patrie et de la maison de ton père, dans le pays que je te montrerai. Je ferai de toi une grande nation, je te bénirai, je rendrai ton nom grand, et tu seras une source de bénédiction."
  },
  {
    "id": "veurey_5",
    "nom": "Le parfum de Béthanie",
    "type": "Église de Veurey-Voroize",
    "numero": 5,
    "fruit": "La générosité",
    "clausule_et_jesus": "que nous honorons",
    "auteur": "Jean",
    "chapitre": 12,
    "premier_verset": 3,
    "verset_fin": 3,
    "traduction": "Crampon 1923",
    "texte": "Marie, ayant pris une livre d'un parfum de nard pur, de grand prix, oignit les pieds de Jésus et les essuya avec ses cheveux ; et la maison fut remplie de l'odeur du parfum."
  },
  {
    "id": "veurey_6",
    "nom": "La Voie, la Vérité, la Vie",
    "type": "Église de Veurey-Voroize",
    "numero": 6,
    "fruit": "Le chemin vers le Père",
    "clausule_et_jesus": "chemin vers le Père",
    "auteur": "Jean",
    "chapitre": 14,
    "premier_verset": 6,
    "verset_fin": 6,
    "traduction": "Crampon 1923",
    "texte": "Jésus lui dit : Je suis la voie, la vérité et la vie ; personne ne vient au Père que par moi."
  },
  {
    "id": "veurey_7",
    "nom": "La parabole des talents",
    "type": "Église de Veurey-Voroize",
    "numero": 7,
    "fruit": "La fidélité dans le service",
    "clausule_et_jesus": "joie de ses serviteurs",
    "auteur": "Matthieu",
    "chapitre": 25,
    "premier_verset": 21,
    "verset_fin": 21,
    "traduction": "Crampon 1923",
    "texte": "Son maître lui dit : C'est bien, serviteur bon et fidèle ; tu as été fidèle en peu de chose, je t'établirai sur beaucoup ; entre dans la joie de ton maître."
  },
  {
    "id": "veurey_8",
    "nom": "La Transfiguration",
    "type": "Église de Veurey-Voroize",
    "numero": 8,
    "fruit": "L'écoute du Fils bien-aimé",
    "clausule_et_jesus": "Fils bien-aimé du Père",
    "auteur": "Matthieu",
    "chapitre": 17,
    "premier_verset": 5,
    "verset_fin": 5,
    "traduction": "Crampon 1923",
    "texte": "Il parlait encore, lorsqu'une nuée lumineuse les couvrit, et une voix sortit de la nuée, disant : Celui-ci est mon Fils bien-aimé, en qui j'ai mis mon affection : écoutez-le."
  },
  {
    "id": "veurey_9",
    "nom": "Le Seigneur, mon berger",
    "type": "Église de Veurey-Voroize",
    "numero": 9,
    "fruit": "La confiance en son berger",
    "clausule_et_jesus": "notre bon pasteur",
    "auteur": "Psaumes",
    "chapitre": 23,
    "premier_verset": 1,
    "verset_fin": 2,
    "traduction": "Crampon 1923",
    "texte": "Yahweh est mon pasteur : je ne manque de rien. Il me fait reposer dans de verts pâturages, il me conduit près des eaux paisibles."
  }
]

  {
    "id": "assomption_2",
    "nom": "La Rencontre d'Élisabeth",
    "type": "Mystères de l'Assomption",
    "numero": 2,
    "fruit": "Le zèle du service",
    "clausule_et_jesus": "porté en hâte chez Élisabeth",

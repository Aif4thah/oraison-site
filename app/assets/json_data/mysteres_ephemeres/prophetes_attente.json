  {
    "id": "prophetes_3",
    "nom": "Le Berger né à Bethléem",
    "type": "L'Attente des Prophètes",
    "numero": 3,
    "fruit": "L'humilité des commencements",
    "clausule_et_jesus": "pasteur né à Bethléem",
    "auteur": "Michée",
    "chapitre": 5,
    "premier_verset": 2,
    "verset_fin": 2,
    "traduction": "Crampon 1923",
    "texte": "Et toi, Bethléem Éphrata, petite entre les milliers de Juda, de toi sortira pour moi celui qui doit dominer en Israël, et dont l'origine remonte aux temps anciens, aux jours de l'éternité."
  },
  {

    "premier_verset": 1,
    "verset_fin": 2,
    "traduction": "Crampon 1923",
    "texte": "Alors Jésus fut conduit par l'Esprit dans le désert pour y être tenté par le diable. Après avoir jeûné pendant quarante jours et quarante nuits, il eut faim."
  },
  {
    "id": "careme_3",
    "nom": "La Parole qui nourrit",
    "type": "Mystères du Carême",
    "numero": 3,
    "fruit": "La confiance en la Parole de Dieu",
    "clausule_et_jesus": "nourri de la Parole",

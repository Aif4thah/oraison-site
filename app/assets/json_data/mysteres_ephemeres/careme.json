    "chapitre": 4,
    "premier_verset": 4,
    "verset_fin": 4,
    "traduction": "Crampon 1923",
    "texte": "Jésus lui répondit : « Il est écrit : L'homme ne vit pas seulement de pain, mais de toute parole qui sort de la bouche de Dieu. »"

  {
    "id": "sacrement_2",
    "nom": "La Cène et l'Offrande du Corps",
    "type": "Mystères du Saint-Sacrement",
    "numero": 2,
    "fruit": "L'action de grâces eucharistique",
    "clausule_et_jesus": "corps livré pour nous",
    "auteur": "Luc",
    "chapitre": 22,
    "premier_verset": 19,
    "verset_fin": 19,
    "traduction": "Crampon 1923",
    "texte": "Puis il prit du pain, et après avoir rendu grâces, il le rompit et le leur donna, disant : « Ceci est mon corps, qui est donné pour vous ; faites ceci en mémoire de moi. »"
  },
  {
    "id": "sacrement_3",
    "nom": "Le Sang de la Nouvelle Alliance",
    "type": "Mystères du Saint-Sacrement",
    "numero": 3,
    "fruit": "Le respect et la pureté du cœur",
    "clausule_et_jesus": "sang de l'alliance nouvelle",
    "auteur": "1 Corinthiens",
    "chapitre": 11,
    "premier_verset": 25,
    "verset_fin": 25,
    "traduction": "Crampon 1923",
    "texte": "De même, après avoir soupé, il prit la coupe, en disant : « Cette coupe est la nouvelle alliance en mon sang ; faites ceci toutes les fois que vous en boirez, en mémoire de moi. »"
  },
  {
    "id": "sacrement_4",
    "nom": "L'Adoration du Cœur à Cœur",
    "type": "Mystères du Saint-Sacrement",
    "numero": 4,
    "fruit": "L'intimité avec le Christ dans l'oraison",
    "clausule_et_jesus": "demeurant en nous",
    "auteur": "Jean",
    "chapitre": 6,
    "premier_verset": 56,
    "verset_fin": 56,
    "traduction": "Crampon 1923",
    "texte": "Celui qui mange ma chair et qui boit mon sang, demeure en moi, et moi en lui."

  {
    "id": "sacrement_5",
    "nom": "Le Viatique pour la Vie Éternelle",
    "type": "Mystères du Saint-Sacrement",
    "numero": 5,
    "fruit": "L'espérance de la résurrection",
    "clausule_et_jesus": "promesse de résurrection",
    "auteur": "Jean",
    "chapitre": 6,
    "premier_verset": 54,
    "verset_fin": 54,
    "traduction": "Crampon 1923",
    "texte": "Celui qui mange ma chair et qui boit mon sang a la vie éternelle, et moi, je le ressusciterai au dernier jour."

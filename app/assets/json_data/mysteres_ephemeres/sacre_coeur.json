  {
    "id": "coeur_2",
    "nom": "Le Transpercement au Calvaire",
    "type": "Mystères du Sacré-Cœur",
    "numero": 2,
    "fruit": "La contrition et la réparation",
    "clausule_et_jesus": "transpercé pour nos péchés",
    "auteur": "Jean",
    "chapitre": 19,
    "premier_verset": 34,
    "verset_fin": 34,
    "traduction": "Crampon 1923",
    "texte": "Mais un des soldats lui transperça le côté avec sa lance, et aussitôt il sortit du sang et de l'eau."
  },
  {
    "id": "coeur_3",
    "nom": "Les Flots d'Eau Vive",
    "type": "Mystères du Sacré-Cœur",
    "numero": 3,
    "fruit": "La soif de la sainteté",
    "clausule_et_jesus": "source d'eau vive",
    "auteur": "Jean",
    "chapitre": 7,
    "premier_verset": 37,
    "verset_fin": 38,
    "traduction": "Crampon 1923",
    "texte": "Jésus se tint debout et s'écria : « Si quelqu'un a soif, qu'il vienne à moi et qu'il boive ! Celui qui croit en moi, des fleuves d'eau vive couleront de son sein. »"
  },
  {
    "id": "coeur_4",
    "nom": "Le Bon Pasteur",
    "type": "Mystères du Sacré-Cœur",
    "numero": 4,
    "fruit": "La compassion pour les pécheurs",
    "clausule_et_jesus": "bon pasteur plein d'amour",
    "auteur": "Luc",
    "chapitre": 15,
    "premier_verset": 4,
    "verset_fin": 6,
    "traduction": "Crampon 1923",
    "texte": "Quel est l'homme d'entre vous qui, ayant cent brebis, s'il en perd une, ne laisse les quatre-vingt-dix-neuf autres dans le désert pour aller après celle qui est perdue, jusqu'à ce qu'il la trouve ? Et quand il l'a trouvée, il la met avec joie sur ses épaules."
  },
  {
    "id": "coeur_5",
    "nom": "L'Amour qui Surpasse toute Connaissance",
    "type": "Mystères du Sacré-Cœur",
    "numero": 5,
    "fruit": "L'enracinement dans l'Amour divin",
    "clausule_et_jesus": "dont l'Amour surpasse tout",
    "auteur": "Éphésiens",
    "chapitre": 3,
    "premier_verset": 17,
    "verset_fin": 19,
    "traduction": "Crampon 1923",
    "texte": "Que le Christ habite dans vos cœurs par la foi ; en sorte que, enracinés et fondés dans la charité, vous puissiez... connaître l'amour du Christ, qui surpasse toute connaissance."
  }

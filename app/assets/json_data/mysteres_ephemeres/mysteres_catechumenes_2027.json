    "nom": "Le Verbe fait chair",
    "type": "Sélection des Catéchumènes 2027",
    "numero": 1,
    "fruit": "L'accueil de la Parole",
    "clausule_et_jesus": "Verbe fait chair",
    "auteur": "Jean",
    "chapitre": 1,
    "premier_verset": 14,
    "verset_fin": 14,
    "traduction": "Crampon 1923",
    "texte": "Et le Verbe s'est fait chair, et il a habité parmi nous, et nous avons vu sa gloire, gloire comme celle du Fils unique venu du Père, plein de grâce et de vérité."
  },
  {
    "id": "catechumenes_2",
    "nom": "Les disciples d'Emmaüs",
    "type": "Sélection des Catéchumènes 2027",
    "numero": 2,
    "fruit": "Le cœur brûlant",
    "clausule_et_jesus": "qui marche avec nous",
    "auteur": "Luc",
    "chapitre": 24,
    "premier_verset": 31,
    "verset_fin": 32,
    "traduction": "Crampon 1923",
    "texte": "Alors leurs yeux s'ouvrirent, et ils le reconnurent ; mais il disparut de devant eux. Et ils se dirent l'un à l'autre : Notre cœur n'était-il pas brûlant au dedans de nous, lorsqu'il nous parlait en chemin et nous expliquait les Écritures ?"
  },
  {
    "id": "catechumenes_3",
    "nom": "La Lumière du monde",
    "type": "Sélection des Catéchumènes 2027",
    "numero": 3,
    "fruit": "La marche dans la lumière",
    "clausule_et_jesus": "lumière du monde",
    "auteur": "Jean",
    "chapitre": 8,
    "premier_verset": 12,
    "verset_fin": 12,
    "traduction": "Crampon 1923",
    "texte": "Jésus leur parla de nouveau, disant : Je suis la lumière du monde ; celui qui me suit ne marche pas dans les ténèbres, mais il aura la lumière de la vie."
  },
  {
    "id": "catechumenes_5",
    "nom": "Qui dites-vous que je suis ?",
    "type": "Sélection des Catéchumènes 2027",
    "numero": 4,
    "fruit": "La profession de foi",
    "clausule_et_jesus": "Christ, Fils du Dieu vivant",
    "auteur": "Matthieu",
    "chapitre": 16,
    "premier_verset": 15,
    "verset_fin": 16,
    "traduction": "Crampon 1923",
    "texte": "Il leur dit : Et vous, qui dites-vous que je suis ? Simon Pierre, prenant la parole, répondit : Vous êtes le Christ, le Fils du Dieu vivant."
  },
  {
    "id": "catechumenes_8",
    "nom": "Tout est possible à celui qui croit",
    "type": "Sélection des Catéchumènes 2027",
    "numero": 5,
    "fruit": "La foi agissante",
    "clausule_et_jesus": "qui fortifie notre foi",
    "auteur": "Marc",
    "chapitre": 9,
    "premier_verset": 23,
    "verset_fin": 23,
    "traduction": "Crampon 1923",
    "texte": "Jésus lui dit : Si tu peux !... Tout est possible à celui qui croit."
  },
  {
    "id": "catechumenes_4",
    "nom": "Porter sa croix",
    "type": "Sélection des Catéchumènes 2027",
    "numero": 6,
    "fruit": "Le courage de suivre le Christ",
    "clausule_et_jesus": "qui nous appelle à le suivre",
    "auteur": "Matthieu",
    "chapitre": 16,
    "premier_verset": 24,
    "verset_fin": 24,
    "traduction": "Crampon 1923",
    "texte": "Alors Jésus dit à ses disciples : Si quelqu'un veut venir après moi, qu'il renonce à lui-même, qu'il se charge de sa croix, et qu'il me suive."
  },
  {
    "id": "catechumenes_6",
    "nom": "Le pardon mutuel",
    "type": "Sélection des Catéchumènes 2027",
    "numero": 7,
    "fruit": "La miséricorde",
    "clausule_et_jesus": "qui nous pardonne",
    "auteur": "Éphésiens",
    "chapitre": 4,
    "premier_verset": 32,
    "verset_fin": 32,
    "traduction": "Crampon 1923",
    "texte": "Soyez bons les uns envers les autres, miséricordieux, vous pardonnant mutuellement, comme Dieu vous a pardonné dans le Christ."
  },
  {
    "id": "catechumenes_9",
    "nom": "Si Dieu est pour nous",
    "type": "Sélection des Catéchumènes 2027",
    "numero": 8,
    "fruit": "La confiance inébranlable",
    "clausule_et_jesus": "notre secours et notre force",
    "auteur": "Romains",
    "chapitre": 8,
    "premier_verset": 31,
    "verset_fin": 31,
    "traduction": "Crampon 1923",
    "texte": "Que dirons-nous donc après cela ? Si Dieu est pour nous, qui sera contre nous ?"
  },
  {
    "id": "catechumenes_7",
    "nom": "Un avenir et de l'espérance",
    "type": "Sélection des Catéchumènes 2027",
    "numero": 9,
    "fruit": "L'espérance et la confiance en Dieu",
    "clausule_et_jesus": "qui nous donne l'espérance",
    "auteur": "Jérémie",
    "chapitre": 29,
    "premier_verset": 11,
    "verset_fin": 11,
    "traduction": "Crampon 1923",
    "texte": "Car moi, je connais les pensées que j'ai pour vous, oracle de Yahweh, pensées de paix, et non de malheur, afin de vous donner un avenir et de l'espérance."
  }
]
